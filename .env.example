# ==============================================================================
# E-Commerce Best Products – MCP Server
# Copy this file to .env and fill in the values
# ==============================================================================

# --- Scraper Mode ---
# "gemini" -> Uses Gemini AI + Google Search grounding for real products
# "mock"   -> Uses mock data (for development/testing without real API calls)
SCRAPER_MODE=gemini

# --- Gemini AI (REQUIRED for SCRAPER_MODE=gemini) ---
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Google Cloud (optional – for Vertex AI real scraper auth) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
