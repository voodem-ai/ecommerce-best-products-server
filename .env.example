# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Google Cloud (optional – for future real scraper auth) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
